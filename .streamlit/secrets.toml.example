# ── 設定範本（Streamlit Community Cloud / 本機開發）────────────────────
# Streamlit Community Cloud：share.streamlit.io → App → Settings → Secrets，
#   直接把下方需要的鍵值貼進 Secrets 輸入框（TOML 格式），存檔後 App 會自動重啟。
# 本機開發：複製此檔為 .streamlit/secrets.toml 後填入（secrets.toml 已加入 .gitignore）。
#
# 註：根層級（非 [section]）的字串／數字會在 Streamlit 解析 secrets 時同步寫入
#     環境變數，因此使用 os.getenv() 或 config.get_setting() 都能讀到。
#     全部設定皆為選用；不設定時系統使用預設值即可正常運作。

# 日誌層級（DEBUG / INFO / WARNING / ERROR）；雲端預設 WARNING，本機預設 INFO
KILO_LOG_LEVEL = "INFO"

# 雲端結果表預覽行數上限（0 = 不限制；僅在偵測到雲端環境時生效）
KILO_CLOUD_RESULT_PREVIEW_LIMIT = 1000

# 亂碼修補（Windows 上載檔案出現亂碼時設為 "1"；Linux 雲端環境不需要）
KILO_FIX_MOJIBAKE = "0"

# 效能計時面板（"1" = 顯示各階段耗時）
KILO_PERF_TIMING = "0"

# 強制指定執行環境：cloud / local（自動偵測失效時才需要設定）
# KILO_RUNTIME = "cloud"
