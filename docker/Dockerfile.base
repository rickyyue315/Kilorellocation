# KiLo 庫存調貨建議系統 — 依賴基底映像
# 由 GitHub Actions（.github/workflows/build-base-image.yml）建置並推送到 Docker Hub（public），
# 只在 requirements.txt 變更時重建。Zeabur 部署時直接 FROM 此映像，
# 省下每次部署重新 pip install（pandas/numpy/streamlit 等約 3~5 分鐘）。
#
# 安全性：此映像只包含公開的 open-source 套件（Python 3.11-slim + PyPI 依賴），
# 不含任何專案原始碼，因此 repo 保持 private 時仍可安全地公開此映像。

FROM python:3.11-slim

# 效能與穩定性：停用位元組碼快取（容器內不需要）、管線輸出即時 flush
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# 僅安裝執行期依賴（測試依賴見 requirements-dev.txt）
COPY requirements.txt ./

RUN pip install --no-cache-dir -r requirements.txt